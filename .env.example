PORT=3000

# ClickUp API
CLICKUP_API_TOKEN=pk_seu_token_aqui
CLICKUP_LIST_ID=sua_list_id_aqui
# Lista de onde a Torre de Controle lê as operações (se vazio, usa CLICKUP_LIST_ID)
CLICKUP_OPS_LIST_ID=sua_list_id_aqui

# Google Drive API
GOOGLE_DRIVE_FOLDER_ID=sua_pasta_drive_id_aqui
GOOGLE_APPLICATION_CREDENTIALS=./credentials-drive.json

# Supabase Storage & Database
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_chave_anon_ou_service_role_aqui
SUPABASE_BUCKET=windgate-docs

# Chave de cifra do banco central guardado no Supabase Storage
WINDGATE_DB_SECRET=gere_com_openssl_rand_hex_32

# Certificado e-CNPJ para o TTCE do Portal Unico (mTLS) — opcional
SISCOMEX_CERT_PFX=./certificado-ecnpj.pfx
SISCOMEX_CERT_SENHA=senha_do_certificado
SISCOMEX_PERFIL=IMPORTADOR
SISCOMEX_PAIS_PADRAO=

# Objeto onde a tabela de aliquotas (TEC+TIPI) e guardada
WINDGATE_ALIQUOTAS_OBJETO=sistema/aliquotas.json
